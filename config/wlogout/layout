{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "[L] LOCK",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "[E] LOGOUT",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "[S] SHUTDOWN",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "[R] REBOOT",
    "keybind" : "r"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "[U] SUSPEND",
    "keybind" : "u"
}
