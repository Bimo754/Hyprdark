[
  // ===========================================================================
  // Hyprdark - Upper Floating Capsule Status Bar
  // ===========================================================================
  {
    "name": "top-bar",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "hyprland/window",
      "custom/vpn",
      "custom/target"
    ],

    "modules-center": [
      "clock"
    ],

    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "battery",
      "tray",
      "custom/control-center",
      "custom/power"
    ],

    // --- Modules Left ---
    "custom/launcher": {
      "format": "󰣇",
      "on-click": "rofi -show drun -theme ~/.config/rofi/theme.rasi",
      "tooltip": false
    },

    "hyprland/workspaces": {
      "disable-scroll": true,
      "all-outputs": true,
      "format": "{name}",
      "persistent-workspaces": {
        "*": 5
      }
    },

    "hyprland/window": {
      "format": "{title}",
      "max-length": 35,
      "separate-outputs": true
    },

    // --- Cybersecurity Ops ---
    "custom/vpn": {
      "exec": "~/.config/waybar/modules/vpn-status.sh",
      "return-type": "json",
      "interval": 3,
      "tooltip": true
    },

    "custom/target": {
      "exec": "~/.config/waybar/modules/target-status.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "bash -c 'target_file=~/.local/share/hyprdark/target_ip; [ -f \"$target_file\" ] && cat \"$target_file\" | wl-copy'",
      "on-click-right": "~/.config/hyprdark/scripts/set-target.sh",
      "tooltip": true
    },

    // --- Modules Center: Prominent Clock & Date ---
    "clock": {
      "interval": 1,
      "format": "  {:%H:%M:%S   󰸗  %a, %b %d}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // --- Modules Right: System Metrics, Control Center & Power ---
    "cpu": {
      "interval": 2,
      "format": "󰍛 {usage}%",
      "tooltip": true
    },

    "memory": {
      "interval": 3,
      "format": "󰘚 {used:0.1f}G",
      "tooltip": true
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 Muted",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "scroll-step": 5,
      "tooltip": true
    },

    "battery": {
      "bat": "BAT0",
      "states": {
        "warning": 25,
        "critical": 10
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "tooltip-format": "{timeTo}, {capacity}%"
    },

    "tray": {
      "icon-size": 15,
      "spacing": 8
    },

    "custom/control-center": {
      "format": "󰖩  󰂯  󰂚",
      "on-click": "swaync-client -t -sw",
      "tooltip-format": "Quick Settings & Control Center"
    },

    "custom/power": {
      "format": "⏻",
      "on-click": "wlogout",
      "tooltip-format": "Power Menu"
    }
  },

  // ===========================================================================
  // Hyprdark - Lower Floating Quick-Launch Dock
  // ===========================================================================
  {
    "name": "bottom-bar",
    "layer": "top",
    "position": "bottom",
    "height": 32,
    "margin-bottom": 6,
    "margin-left": 160,
    "margin-right": 160,
    "spacing": 8,

    "modules-center": [
      "custom/quick-term",
      "custom/quick-scratch",
      "custom/quick-files",
      "custom/quick-web",
      "custom/quick-edit",
      "custom/quick-wall",
      "network",
      "disk"
    ],

    "custom/quick-term": {
      "format": " Terminal",
      "on-click": "kitty",
      "tooltip-format": "Launch Kitty Terminal"
    },

    "custom/quick-scratch": {
      "format": " Quake",
      "on-click": "hyprctl dispatch togglespecialworkspace scratchpad",
      "tooltip-format": "Toggle Quake Scratchpad Terminal"
    },

    "custom/quick-files": {
      "format": " Files",
      "on-click": "thunar",
      "tooltip-format": "Launch Thunar File Manager"
    },

    "custom/quick-web": {
      "format": "󰈹 Web",
      "on-click": "brave",
      "tooltip-format": "Launch Brave Browser"
    },

    "custom/quick-edit": {
      "format": " Edit",
      "on-click": "subl",
      "tooltip-format": "Launch Sublime Text"
    },

    "custom/quick-wall": {
      "format": "󰸉 Wall",
      "on-click": "~/.config/hyprdark/scripts/wallpaper-ctl.sh",
      "tooltip-format": "Change Wallpaper / Video Background"
    },

    "network": {
      "format-wifi": " {essid}",
      "format-ethernet": "󰈀 {ipaddr}",
      "format-disconnected": "󰖪 Off",
      "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },

    "disk": {
      "interval": 30,
      "format": "󰋊 {percentage_used}%",
      "path": "/"
    }
  }
]

